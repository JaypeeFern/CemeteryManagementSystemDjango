# Local Docker Compose settings. Keep production values in Coolify secrets.
DJANGO_SECRET_KEY=local-development-key-change-before-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
GOOGLE_RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret
GOOGLE_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
APP_DATA_PATH=./.compose-data
